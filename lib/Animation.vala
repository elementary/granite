namespace Granite.AnimationDuration {
    /**
     * When a widget closes, hides a portion of its content, or exits the screen
     */
    public const uint CLOSE = 200;

    /**
     * When a widget transforms in-place, like when filtering content with a view switcher
     */
    public const uint IN_PLACE = 100;

    /**
     * When a widget opens, reveals more content, or enters the screen
     */
    public const uint OPEN = 250;
}
